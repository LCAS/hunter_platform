<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <!--
      MIGRATION (Gazebo Classic -> new Gazebo / Harmonic, ROS 2 Jazzy):
      The new Gazebo does not auto-load simulation systems for a custom world the
      way the built-in `empty.sdf` does. Every capability (physics, GUI streaming,
      sensor rendering, IMU, GPS) must be added explicitly as a <plugin> system,
      otherwise sensors are defined in the URDF but never produce data.
    -->

    <!-- Core systems: physics + user commands (spawn/delete) + scene streaming. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Renders and publishes all rendering-based sensors: gpu_lidar + cameras. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Publishes data for every <sensor type="imu"> in the model. -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>

    <!-- Publishes data for every <sensor type="navsat"> (GPS) in the model. -->
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat">
    </plugin>

    <!-- A global light source -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>53.268642038</latitude_deg>
      <longitude_deg>-0.524509505881</longitude_deg>
      <elevation>0.0</elevation>
      <!-- currently gazebo has a bug: instead of outputing lat, long, altitude in ENU
      (x = East, y = North and z = Up) as the default configurations, it's outputting (-E)(-N)U,
      therefore we rotate the default frame 180 so that it would go back to ENU -->
      <heading_deg>180</heading_deg>
    </spherical_coordinates>
  </world>
</sdf>
