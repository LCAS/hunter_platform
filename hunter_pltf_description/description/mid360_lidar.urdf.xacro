<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="mid360_lidar"
               params="name parent:='base_link'
                       raw_topic:='lidar/raw_gpu'
                       points_topic:='lidar/points'
                       diagnostics_topic:='lidar/diagnostics'
                       frame_id:='lidar_link'
                       origin_xyz:='0 0 0' origin_rpy:='0 0 0'
                       update_rate:=10
                       h_samples:=2048 v_samples:=512
                       samples:=24000 downsample:=1
                       min_range:=0.1 max_range:=200.0
                       is_sim:=true">

    <link name="${name}">
      <inertial>
        <mass value="0.4"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0004" ixy="0.0" ixz="0.0"
                 iyy="0.0004" iyz="0.0" izz="0.0004"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://livox_mid360_gz/models/livox_mid360_standalone/meshes/livox360.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.07"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
    </joint>

    <xacro:if value="${is_sim}">
      <gazebo reference="${name}">
        <sensor name="${name}_raw_gpu_lidar" type="gpu_lidar">
          <topic>${raw_topic}</topic>
          <update_rate>${update_rate}</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>${h_samples}</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </horizontal>
              <vertical>
                <samples>${v_samples}</samples>
                <resolution>1</resolution>
                <min_angle>-0.12601233157</min_angle>
                <max_angle>0.96377007742</max_angle>
              </vertical>
            </scan>
            <range>
              <min>${min_range}</min>
              <max>${max_range}</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </gazebo>

      <gazebo>
        <plugin filename="liblivox_mid360_gz_plugin.so"
                name="livox_mid360_gz::LivoxMid360GpuLidar">
          <input_topic>${raw_topic}/points</input_topic>
          <output_topic>${points_topic}</output_topic>
          <diagnostics_topic>${diagnostics_topic}</diagnostics_topic>
          <frame_id>${frame_id}</frame_id>
          <frame_rate>${update_rate}</frame_rate>
          <samples>${samples}</samples>
          <downsample>${downsample}</downsample>
          <scan_pattern_file>package://livox_mid360_gz/scan_mode/mid360.csv</scan_pattern_file>
          <min_range>${min_range}</min_range>
          <max_range>${max_range}</max_range>
          <range_noise_stddev>0.01</range_noise_stddev>
          <input_horizontal_samples>${h_samples}</input_horizontal_samples>
          <input_vertical_samples>${v_samples}</input_vertical_samples>
          <input_min_elevation>-0.12601233157</input_min_elevation>
          <input_max_elevation>0.96377007742</input_max_elevation>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
