<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
 <xacro:macro name="hunter_depth_camera" params="name x y z roll:=0.0 pitch:=0.0 yaw:=0.0 is_sim:=true">
    <joint name="${name}_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="${name}_link"/>
        <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>

    <link name="${name}_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 -1.57"/>
            <geometry>
                <mesh filename="file://$(find hunter_pltf_description)/meshes/zed2.dae"/>
            </geometry>
        </visual>
    </link>

    <joint name="${name}_optical_joint" type="fixed">
        <parent link="${name}_link"/>
        <child link="${name}_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="${name}_link_optical"></link>


<xacro:if value="${is_sim}">
    <!--
      MIGRATION (Gazebo Classic -> new Gazebo / Harmonic):
      Sensor type changed from "depth" to "rgbd_camera". In the new Gazebo an
      rgbd_camera natively renders both the RGB image and a registered 3D point
      cloud, rendered by the `gz-sim-sensors-system` world plugin. With <topic>
      set to "/<name>/depth", it publishes:
        /<name>/depth/image        gz.msgs.Image            (RGB image)
        /<name>/depth/depth_image  gz.msgs.Image            (depth image)
        /<name>/depth/points       gz.msgs.PointCloudPacked (3D cloud)
        /<name>/depth/camera_info  gz.msgs.CameraInfo
      These are bridged to ROS 2 sensor_msgs in gz_bridge.yaml.
      `gz_frame_id` stamps the data with the optical frame for correct TF.
    -->
    <gazebo reference="${name}_link">
        <sensor name="${name}_camera" type="rgbd_camera">
            <topic>/${name}/depth</topic>
            <gz_frame_id>${name}_link_optical</gz_frame_id>
            <pose> 0 0 0 0 0 0 </pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera>
                <horizontal_fov>2.089</horizontal_fov>
                <image>
                    <format>B8G8R8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>
</xacro:if>
</xacro:macro>
</robot>
