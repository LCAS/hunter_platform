<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="hunter_gps" params="name x:=0.0 y:=0.0 z:=0.0 roll:=0.0 pitch:=0.0 yaw:=0.0 is_sim:=true">
    
    <!-- Choose yaw value: force to 0.0 in simulation, else use provided yaw -->
    <xacro:property name="final_yaw" value="${0.0 if is_sim else yaw}" />
    
    <!-- Define the joint and link once -->
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${final_yaw}"/>
    </joint>
    <link name="${name}_link"/>
    
    <!-- Add Gazebo sensor only when in simulation -->
    <xacro:if value="${is_sim}">
      <!--
        MIGRATION (Gazebo Classic -> new Gazebo / Harmonic):
        The sensor type is now "navsat" (was "gps"). In the new Gazebo the GPS
        sensor type was renamed to NavSat, and it is driven by the
        `gz-sim-navsat-system` world plugin (added in empty_world.world).
        The sensor publishes a gz.msgs.NavSat message on the gz topic below,
        which gz_bridge.yaml bridges to sensor_msgs/NavSatFix for ROS 2.
        The world's <spherical_coordinates> provides the datum used to convert
        the local ENU pose into latitude/longitude/altitude.
      -->
      <gazebo reference="${name}_link">
        <sensor name="${name}_navsat" type="navsat">
          <topic>${name}/fix</topic>
          <gz_frame_id>${name}_link</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
        </sensor>
      </gazebo>
    </xacro:if>
    
  </xacro:macro>
</robot>
